# Render API environment ONLY. Never import this file into Vercel or a mobile build.
# Add only the dedicated backend credential; never the Mac's personal Google refresh credentials.
NODE_ENV=production
APP_MODE=firebase
PAYMENT_MODE=razorpay
RAZORPAY_ENVIRONMENT=test
RELEASE_CHANNEL=staging
FIREBASE_PROJECT_ID=anvira-services
FIREBASE_SERVICE_ACCOUNT_B64=
WEB_APP_URL=https://anvira-homeservices.vercel.app
ALLOWED_ORIGINS=https://anvira-homeservices.vercel.app,https://anvira-homeservices-git-main-anvira2.vercel.app
TRUST_PROXY=1
RUN_BACKGROUND_JOBS=true
# Render's verified RENDER_EXTERNAL_URL is used when PUBLIC_API_URL is absent.
# Free preview: no persistent documents, Storage bucket, payouts or payment secrets configured.
