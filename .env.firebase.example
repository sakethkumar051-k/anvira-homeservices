# Verified public Firebase identifiers. Keep demo mode until backend deployment and live gates pass.
# Client configuration is public. These values identify your Firebase/EAS app.
EXPO_PUBLIC_AUTH_MODE=demo
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_FIREBASE_PROJECT_ID=anvira-services
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyChecPmb4UGeQmuoI-TPi4v-GckqQi7EB0
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=anvira-services.firebaseapp.com
EXPO_PUBLIC_FIREBASE_APP_ID=1:516523404901:web:ad16301b785df6eef0a08c
# Public OAuth IDs from the Google provider and refreshed native configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=516523404901-2v0e78kfekn4fg48mdofi53l97lram03.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=516523404901-prkc28t4tgir0i8ntsjm8s0m9ub76rq5.apps.googleusercontent.com
EXPO_PUBLIC_EAS_PROJECT_ID=
# EAS file variables: paths supplied by EAS or by local prebuild.
GOOGLE_SERVICES_IOS=
GOOGLE_SERVICES_ANDROID=
# Server configuration. Never prefix any secret with EXPO_PUBLIC_.
APP_MODE=demo
PORT=4000
# Live: APP_MODE=firebase, PAYMENT_MODE=razorpay, NODE_ENV=production.
FIREBASE_PROJECT_ID=anvira-services
FIREBASE_STORAGE_BUCKET=
PUBLIC_API_URL=https://YOUR_DOMAIN
WEB_APP_URL=https://YOUR_DOMAIN
ALLOWED_ORIGINS=https://YOUR_DOMAIN
TRUST_PROXY=0
PAYMENT_MODE=demo
# Use Application Default Credentials locally, workload identity in deployed Functions.
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/service-account.json
# Store actual payment credentials in Firebase Secret Manager, never in this example.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional partner withdrawals; leave disabled until RazorpayX is approved and static egress is allowlisted.
PAYOUTS_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Optional Expo enhanced push security token, server only.
EXPO_ACCESS_TOKEN=
VPC_CONNECTOR=

# Optional standalone deployment: encrypted private documents instead of Firebase Storage.
# Attach a persistent private volume before confirming this option.
PRIVATE_DOCUMENT_DIR=
DOCUMENT_ENCRYPTION_KEY=
PERSISTENT_DOCUMENT_VOLUME=false
RUN_BACKGROUND_JOBS=true
# Separate key; keep encrypted backups off-site and rehearse restore.
BACKUP_ENCRYPTION_KEY=
# Enable only after Apple capability, Firebase provider and device checks.
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
RELEASE_TARGET=web
