# Vercel website build environment. No server secrets belong here.
ANVIRA_API_ORIGIN=https://your-api-host.example.invalid
EXPO_PUBLIC_AUTH_MODE=firebase
# Set staging only for the incomplete client preview; remove it after launch gates pass.
EXPO_PUBLIC_RELEASE_CHANNEL=staging
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Keep blank for the Vercel website: its API/payment requests use same-origin proxy routes.
EXPO_PUBLIC_API_URL=
