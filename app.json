    "icon": "./assets/anvira-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anvira.services"
    },
    "android": {
      "package": "com.anvira.services",
      "adaptiveIcon": {
        "foregroundImage": "./assets/anvira-logo.png",
        "backgroundColor": "#073F32"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "anvira"
  }
}
