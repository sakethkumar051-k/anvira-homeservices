    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@grpc/grpc-js": "1.14.5",
    "@playwright/test": "^1.63.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test tests/*.test.mjs",
    "export:web": "node scripts/export-app.mjs --platform web",
    "preview": "npm run export:web && npm run api",
    "test:ui": "node tests/browser.cjs",
    "format": "prettier --write src server tests",
    "stage:functions": "node scripts/stage-functions.mjs",
    "check:release": "node scripts/check-release.mjs",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:all": "node scripts/export-app.mjs --platform all --output-dir build-check",
    "test:firestore": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-anvira \"node scripts/emulator-checks.mjs\"",
    "demo": "node scripts/run-demo.mjs",
    "export:demo": "EXPO_PUBLIC_AUTH_MODE=demo EXPO_PUBLIC_API_URL= APP_MODE=demo PAYMENT_MODE=demo node scripts/export-app.mjs --platform web --output-dir dist-demo",
    "test:ui:features": "node tests/browser-features.cjs",
    "test:ui:auth": "node tests/browser-auth.cjs",
    "test:ui:launch": "node tests/browser-launch.cjs",
    "backup:data": "node scripts/backup-data.mjs",
    "seed:demo": "node scripts/seed-review-demo.mjs",
    "test:stress": "node scripts/stress-test.mjs",
    "check:razorpay": "node scripts/check-razorpay.mjs",
    "check:android-demo": "node scripts/check-android-demo.mjs",
    "build:website": "node scripts/build-website.mjs",
    "test:ui:website": "node tests/browser-website.cjs",
    "check:source": "node scripts/check-source-secrets.mjs",
    "test:ui:marketing": "node tests/browser-marketing.cjs",
    "test:ui:marketplace": "node tests/browser-marketplace.cjs",
    "test:ui:office": "node tests/browser-office.cjs",
    "test:ui:landing": "node tests/browser-landing-navigation.cjs",
    "test:ui:services": "node tests/browser-service-management.cjs"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "basic-ftp": "^6.2.2",
    "@opentelemetry/core": "^2.8.0",
    "decode-uri-component": "^0.5.0",
    "react-server-dom-webpack": "19.3.0"
  }
}
